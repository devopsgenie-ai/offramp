{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "ArgoCD ApplicationSet. SPIKE.md #18: kubeconform has no schema for this kind, so the one file that connects the generated tree to a real cluster was reported as Skipped and validated by nothing. This is a hand-written subset covering the fields offramp emits -- enough to catch a missing repoURL, a missing destination, or a typo in a key.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "argoproj.io/v1alpha1" },
    "kind": { "const": "ApplicationSet" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "required": ["generators", "template"],
      "additionalProperties": false,
      "properties": {
        "goTemplate": { "type": "boolean" },
        "generators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "git": {
                "type": "object",
                "required": ["repoURL", "revision"],
                "properties": {
                  "repoURL": { "type": "string", "minLength": 1 },
                  "revision": { "type": "string", "minLength": 1 },
                  "directories": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["path"],
                      "properties": {
                        "path": { "type": "string", "minLength": 1 },
                        "exclude": { "type": "boolean" }
                      }
                    }
                  },
                  "files": { "type": "array" }
                }
              },
              "list": { "type": "object" },
              "clusters": { "type": "object" },
              "matrix": { "type": "object" },
              "merge": { "type": "object" }
            }
          }
        },
        "template": {
          "type": "object",
          "required": ["metadata", "spec"],
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "labels": { "type": "object" },
                "annotations": { "type": "object" },
                "finalizers": { "type": "array", "items": { "type": "string" } }
              }
            },
            "spec": {
              "type": "object",
              "required": ["project", "source", "destination"],
              "additionalProperties": false,
              "properties": {
                "project": { "type": "string", "minLength": 1 },
                "source": {
                  "type": "object",
                  "required": ["repoURL", "path", "targetRevision"],
                  "properties": {
                    "repoURL": { "type": "string", "minLength": 1 },
                    "path": { "type": "string", "minLength": 1 },
                    "targetRevision": { "type": "string", "minLength": 1 }
                  }
                },
                "destination": {
                  "type": "object",
                  "required": ["namespace"],
                  "properties": {
                    "server": { "type": "string", "minLength": 1 },
                    "name": { "type": "string", "minLength": 1 },
                    "namespace": { "type": "string", "minLength": 1 }
                  }
                },
                "syncPolicy": {
                  "type": "object",
                  "properties": {
                    "automated": {
                      "type": "object",
                      "properties": {
                        "prune": { "type": "boolean" },
                        "selfHeal": { "type": "boolean" },
                        "allowEmpty": { "type": "boolean" }
                      }
                    },
                    "syncOptions": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
